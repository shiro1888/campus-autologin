@echo off
chcp 936 >nul
title 刷新 Chrome 扩展（重要：改动后必须执行）
cd /d "%~dp0"

echo.
echo ============================================================
echo   刷新 Chrome 扩展
echo ============================================================
echo.
echo   为什么要做这一步：
echo   Chrome 只在加载扩展那一刻读取代码，之后一直用内存里的旧副本。
echo   在此处直接按 F5 刷新设置页是无效的。
echo.
echo ------------------------------------------------------------
echo   请按以下 3 步操作：
echo ------------------------------------------------------------
echo.
echo   [1] 找到「校园网自动登录」卡片
echo.
echo   [2] 点卡片右下角的 [刷新] 按钮（转圈箭头图标）
echo.
echo   [3] 关键：把之前打开的设置页标签全部关掉，重新打开
echo       （旧标签页跑的还是旧代码）
echo.
echo ------------------------------------------------------------
echo   如何确认刷新成功：
echo   设置页右上角会显示最新版本号: v1.3.0
echo   版本号对了 = 成功；没有或显示旧版 = 尚未生效
echo ------------------------------------------------------------
echo.

start "" chrome.exe "chrome://extensions/"
timeout /t 5 >nul
exit /b 0
