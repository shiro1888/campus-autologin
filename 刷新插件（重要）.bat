@echo off
chcp 936 >nul
title 刷新 Chrome 插件（必需，否则改动不生效）
cd /d "%~dp0"

echo.
echo ============================================================
echo   刷新 Chrome 插件
echo ============================================================
echo.
echo   为什么要做这一步？
echo   Chrome 只在「加载扩展」那一刻读取代码，之后一直用内存里的旧副本。
echo   改了磁盘上的文件，不点刷新是不会生效的。
echo.
echo ------------------------------------------------------------
echo   请按下面 3 步操作：
echo ------------------------------------------------------------
echo.
echo   [1] 浏览器打开后，找到「校园网自动登录」卡片
echo.
echo   [2] 点卡片右下角的  刷新 按钮（一个转圈箭头）
echo.
echo   [3] 关键！把之前开着的设置页标签全部关掉，再重新打开
echo       （旧标签页里跑的还是旧代码）
echo.
echo ------------------------------------------------------------
echo   怎么确认成功：
echo   设置页标题右边会显示  v1.1.1
echo   看到版本号 = 成功；没看到 = 还是旧的
echo ------------------------------------------------------------
echo.

start "" chrome.exe "chrome://extensions/"
timeout /t 5 >nul
exit /b 0