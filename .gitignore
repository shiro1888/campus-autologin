# 运行日志（保留目录本身，忽略里面的日志文件）
logs/*
!logs/.gitkeep
*.log

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 临时/侦察目录
.recon/
_verify/
_h1/

# 本地个人配置（含真实密码）——默认不提交
# 如果你 fork 了这个项目，请复制 config.example.json 为 config.json 并填入自己的账号密码
config.json
config.local.json
campus-autologin-config-*.json
.python_path

# 编辑器与工具
.vscode/
.idea/
*.swp
.zcodeignore

# 系统
Thumbs.db
desktop.ini
.DS_Store
